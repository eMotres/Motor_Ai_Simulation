rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in user fully owns everything under users/{uid}.
    // No one else can read or write it.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Public catalog is read-only to clients; only admins (server / console) write.
    match /catalog/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Server-only config (AI provider keys in /config/ai, etc.) — written by the
    // backend via the Admin SDK. NEVER client-accessible. The deny-all default
    // below already covers this; kept explicit so the intent is obvious.
    match /config/{document=**} {
      allow read, write: if false;
    }

    // Shared (admin-managed) materials library. Only the backend touches it —
    // reads + writes go through the Admin SDK (GET /api/materials/library serves
    // it; POST/DELETE /api/materials/global, admin-gated, mutate it). Clients
    // never access it directly. (Per-user "my materials" live under
    // users/{uid}/materials, already covered by the owner rule above.)
    match /materials_global/{id} {
      allow read, write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
