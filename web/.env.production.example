# Production env — copy to web/.env.production and fill in real values.
#
# These VITE_* values are PUBLIC: Vite bakes them into the client bundle at build
# time — none of them are secrets.
VITE_API_URL=https://YOUR-BACKEND.a.run.app

# Google OAuth Client ID (Web application) for the Sign-in-with-Google button.
# Must equal the backend's GOOGLE_CLIENT_ID. Empty = password login only.
VITE_GOOGLE_CLIENT_ID=
