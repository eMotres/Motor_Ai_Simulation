VITE_API_URL=http://localhost:8001

# Google OAuth Client ID (Web application) for the Sign-in-with-Google button.
# Must equal the backend's GOOGLE_CLIENT_ID. Empty = password login only.
VITE_GOOGLE_CLIENT_ID=

# Google Analytics 4 measurement id (stream aerostator-web). Optional: the code
# default is G-R2325XYL2S. Set it empty to switch analytics off for a build.
# See src/lib/analytics.ts: loaded only after the app mounted, only after Accept,
# never for China / Do Not Track / Global Privacy Control.
# VITE_GA_ID=G-R2325XYL2S

# Self-hosted Umami website id (same-origin tracker at /stats, cookieless, loaded for every
# visitor who has not set Do Not Track / Global Privacy Control). Code default is built in.
# VITE_UMAMI_WEBSITE_ID=8fe8df44-5870-4f08-bfc4-16a79aa44f17
