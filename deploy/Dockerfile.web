# motor_ai_sim web frontend — static build served by nginx.
# Build from the REPO ROOT:
#   docker build -f deploy/Dockerfile.web \
#     --build-arg VITE_GOOGLE_CLIENT_ID=<client id> .
# VITE_API_URL defaults to "" = same-origin (nginx proxies /api to the API
# container) — override only for a split-host deploy.
FROM node:22-slim AS build
WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ .
# The app version is the REPO ROOT's VERSION file: vite.config reads
# `<cwd>/../VERSION`, and with WORKDIR /app that is exactly /VERSION.  Without
# it the define falls back to "0.0.0" and every deployed page showed "v0.0.0" in
# the header while the workstation showed the real number (found live,
# 2026-09-16 — the build context is the repo root, only `web/` was ever copied).
COPY VERSION /VERSION
ARG VITE_API_URL=""
ARG VITE_GOOGLE_CLIENT_ID=""
ENV VITE_API_URL=$VITE_API_URL \
    VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
RUN npm run build && node scripts/module-fingerprints.mjs > /app/dist/.modules.json

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
# Client IP trust (docs/MCP_DISCOVERY.md "Client IP"): the entrypoint hook
# writes /etc/nginx/realip/trusted.conf from this network's gateway at every
# start; the file baked here is the fail-closed default (loopback only).
COPY deploy/nginx-realip-gateway.sh /docker-entrypoint.d/15-realip-gateway.sh
COPY deploy/nginx-webroot.sh /docker-entrypoint.d/16-webroot.sh
# Which API instance (blue / green) is the upstream: chosen by the host (deploy/bluegreen.sh), see the script.
COPY deploy/nginx-upstream.sh /docker-entrypoint.d/17-upstream.sh
RUN chmod 0755 /docker-entrypoint.d/15-realip-gateway.sh /docker-entrypoint.d/16-webroot.sh /docker-entrypoint.d/17-upstream.sh \
 && sed -i 's/\r$//' /docker-entrypoint.d/15-realip-gateway.sh /docker-entrypoint.d/16-webroot.sh /docker-entrypoint.d/17-upstream.sh \
 && echo 'root /usr/share/nginx/html;' > /etc/nginx/webroot.conf \
 && echo 'server api:8001;' > /etc/nginx/api-upstream.conf \
 && mkdir -p /etc/nginx/realip \
 && echo 'set_real_ip_from 127.0.0.1;' > /etc/nginx/realip/trusted.conf
COPY --from=build /app/dist /usr/share/nginx/html
# The build id the running pages compare against (components/common/UpdateBanner.tsx): a new id = "new version, reload".
ARG BUILD_ID=dev
# + the module fingerprints: a production-only deploy asks only the Production tab to reload
RUN echo "{\"build\": \"${BUILD_ID}\", \"modules\": $(cat /usr/share/nginx/html/.modules.json)}" > /usr/share/nginx/html/build.json  && rm -f /usr/share/nginx/html/.modules.json
EXPOSE 80
