index 0000000..625c879
--- /dev/null
+++ b/tests/test_p2_cut_facets.py
@@ -0,0 +1,105 @@
+"""Radial-cut P2 constraints follow actual disconnected-half connectivity."""
+import math
+
+import numpy as np
+import pytest
+from skfem import Basis, ElementTriP2, MeshTri
+
+from motor_ai_sim.simulation.p2_projection import SlipProjection
+
+
+def geometric_cut_pairs(mesh, basis, nsn, angle):
+    """Independent oracle: boundary facets, geometric rotation, half identity.
+
+    Does not use Mn/Sn ordering or the implementation's stored cut constraints.
+    """
+    boundary = mesh.boundary_facets()
+    fp = mesh.p[:, mesh.facets[:, boundary]]
+    centers = fp.mean(axis=1)
+    direction = np.array([math.cos(angle), math.sin(angle)])
+    on_master = np.all(abs(fp[1]) < 1e-10, axis=0) & (centers[0] > 0.)
+    on_slave = np.all(abs(direction[1]*fp[0]-direction[0]*fp[1]) < 1e-10, axis=0) & (direction @ centers > 0.)
+    masters, slaves = boundary[on_master], boundary[on_slave]
+    slave_vertices = np.unique(mesh.facets[:, slaves])
+    c, s = math.cos(angle), math.sin(angle)
+    rotation = np.array([[c, -s], [s, c]])
+    vertex_map = {}
+    for node in np.unique(mesh.facets[:, masters]):
+        candidates = slave_vertices[(slave_vertices < nsn) == (node < nsn)]
+        distance = np.linalg.norm(mesh.p[:, candidates]-rotation @ mesh.p[:, node, None], axis=0)
+        assert np.sum(distance < 1e-10) == 1
+        vertex_map[int(node)] = int(candidates[np.argmin(distance)])
+    lookup = {tuple(sorted(map(int, mesh.facets[:, fi]))): int(fi) for fi in slaves}
+    pairs, covered = [], set()
+    for fm in masters:
+        endpoints = tuple(sorted(vertex_map[int(v)] for v in mesh.facets[:, fm]))
+        fs = lookup[endpoints]
+        covered.add(fs)
+        pairs.append((int(basis.facet_dofs[0, fs]), int(basis.facet_dofs[0, fm])))
+    assert covered == set(map(int, slaves))
+    return pairs
+
+
+def synthetic(order, sign):
+    segments, nv = 6, 7
+    angle = np.linspace(0., np.pi/2, nv)
+    def half(radii):
+        points = np.array([(r*np.cos(a), r*np.sin(a)) for r in radii for a in angle]).T
+        cells = []
+        for layer in range(2):
+            for k in range(segments):
+                a, b, c, d = layer*nv+k, layer*nv+k+1, (layer+1)*nv+k, (layer+1)*nv+k+1
+                cells.extend([(a, c, d), (a, d, b)])
+        return points, np.array(cells).T
+    ps, ts = half((1., 1.2, 1.4))
+    pr, tr = half((.5, .8, 1.))
+    nsn = ps.shape[1]
+    mesh = MeshTri(np.hstack([ps, pr]), np.hstack([ts, tr+nsn]))
+    basis = Basis(mesh, ElementTriP2())
+    # Distinct stator/rotor vertices share r=1. Interleaving them breaks the
+    # old assumption that adjacent entries necessarily delimit real facets.
+    master = np.array([nsn, nsn+nv, 0, nsn+2*nv, nv, 2*nv])[order]
+    slave = master+nv-1
+    args = dict(n_dof=basis.N, facets=mesh.facets, vdof=basis.nodal_dofs[0],
+                fdof=basis.facet_dofs[0], rring=np.arange(2*nv, 3*nv), sring=np.arange(nv),
+                nsn=nsn, n_ring=nv, full_ring=False, bc_sign=sign, Mn=master, Sn=slave,
+                dirichlet_dofs=np.array([], int))
+    return mesh, basis, args
+
+
+def assert_geometric_rows(proj, pairs, shifts):
+    assert {(s, m) for s, m, _ in proj._cut_e} == set(pairs)
+    ranks = []
+    for shift in shifts:
+        matrix, _ = proj.build(shift)
+        assert np.all(np.diff(matrix.indptr) == 1)
+        columns, values = matrix.indices[matrix.indptr[:-1]], matrix.data[matrix.indptr[:-1]]
+        for slave, master in pairs:
+            assert columns[slave] == columns[master]
+            assert values[slave] == proj.bc_sign*values[master]
+        for slave, master, sign in proj._cut_v:
+            assert columns[slave] == columns[master] and values[slave] == sign*values[master]
+        ranks.append(matrix.shape[1])
+    assert len(set(ranks)) == 1
+
+
+@pytest.mark.parametrize("sign", [-1., 1.])
+@pytest.mark.parametrize("order", [np.arange(6), np.arange(5, -1, -1), np.array([0, 2, 4, 1, 3, 5])],
+                         ids=["interleaved-radii", "reverse", "shuffled-pairs"])
+def test_all_actual_cut_facets_are_welded_despite_pair_interleaving(sign, order):
+    mesh, basis, args = synthetic(order, sign)
+    pairs = geometric_cut_pairs(mesh, basis, args["nsn"], np.pi/2)
+    assert len(pairs) == 4
+    proj = SlipProjection(**args)
+    assert proj.n_cut_e == 4
+    assert_geometric_rows(proj, pairs, [0, 2, 5, 6, -2, -13, 17, 601])
+
+
+def test_missing_counterpart_is_an_explicit_invalid_cut_error():
+    mesh, basis, args = synthetic(np.arange(6), -1.)
+    pairs = geometric_cut_pairs(mesh, basis, args["nsn"], np.pi/2)
+    missing_slave_dof = pairs[0][0]
+    keep = args["fdof"] != missing_slave_dof
+    args["facets"], args["fdof"] = args["facets"][:, keep], args["fdof"][keep]
+    with pytest.raises(ValueError, match="P2 radial-cut facet.*no matching slave facet"):
+        SlipProjection(**args)
