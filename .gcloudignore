# Keep the Cloud Build context small: only src/ + config/ + Dockerfile + requirements
.git/
.gitignore
web/
**/node_modules/
**/__pycache__/
**/*.pyc
.venv/
venv/
env/
simulation_output/
geometry_cache/
*.log
# root-level diagnostic scripts/artefacts ONLY — anchored so it does NOT match
# package __init__.py / _*.py modules deep in src/
/_*.py
/_*.json
/_*.txt
/*.png
DEPLOY.md
ARCHITECTURE_SECURITY.md
firebase.json
.firebaserc
