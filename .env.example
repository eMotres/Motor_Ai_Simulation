# motor_ai_sim backend — deployment environment (all optional in local dev).

# 1 = enforce auth: anonymous callers get tier "anon", role limits apply.
#     Unset/0 = local dev mode: everyone is admin, nothing is restricted.
AUTH_ENFORCE=0

# Comma-separated emails that are ALWAYS admin (overrides users.json tier).
ADMIN_EMAILS=vadim@motresres.com

# Google OAuth Client ID (Web application) — enables "Sign in with Google".
# Must equal the frontend's VITE_GOOGLE_CLIENT_ID. Empty = Google sign-in off
# (password accounts in config/users.json still work).
GOOGLE_CLIENT_ID=

# JWT signing secret for our session tokens. Empty = auto-generated into
# config/.auth_secret on first use (fine for one node). Set explicitly when
# running more than one API node so tokens verify everywhere.
AUTH_SECRET=

# Extra CORS origins for production, comma-separated (localhost is built in).
# e.g. https://emotres.com,https://www.emotres.com
ALLOWED_ORIGINS=

# ── deploy/.env only: BUILD-time interpolation for docker compose ───────────
# Copy this file to deploy/.env for the compose build. The RUNTIME contract is
# a separate file, /etc/motres/api.env (root:root 0600) — see
# scripts/api.env.example and deploy/README.md. The split exists because the
# frontend bakes VITE_GOOGLE_CLIENT_ID into its bundle at build time, so that
# one value has to be readable by `docker build`; an OAuth client id is public
# by design, a session secret is not.

# Where the copy of the Windows box's config/ was unpacked. Mounted read-only
# at /seed-src by the `motres-seed` one-shot.
SEED_SRC=/srv/motres/seed-src
