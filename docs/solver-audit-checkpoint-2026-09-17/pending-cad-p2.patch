+"""Bounded source-frame cleanup; no claim of a generic invariant sanitizer."""
+import numpy as np
+import pytest
+from shapely.affinity import rotate, translate
+from shapely.geometry import Polygon
+
+from motor_ai_sim import cadquery_geometry as cad
+from tests.test_stator_mouth_symmetry import arguments, assert_same_shape
+from tests.test_cad_polygon_quality import _cases, _build, _rings
+
+
+def points(geom):
+    return {(round(x, 9), round(y, 9)) for _, ring in _rings(geom, "g") for x, y in ring}
+
+
+def topology(geom):
+    parts = list(geom.geoms) if hasattr(geom, "geoms") else [geom]
+    return sorted(len(part.interiors) for part in parts)
+
+
+def test_source_cleanup_is_cyclic_reversal_independent_and_idempotent():
+    args = arguments()
+    source = cad._safe_union(Polygon(args[:4]), Polygon(cad._arc_points(
+        args[2][0], args[2][1], args[4], 0., 2*np.pi, args[5])[:-1]))
+    expected = cad._clean_stator_mouth_cutter(source, args[5])
+    coords = list(source.exterior.coords)[:-1]
+    for offset in range(len(coords)):
+        rolled = coords[offset:]+coords[:offset]
+        for ordered in (rolled, rolled[::-1]):
+            result = cad._clean_stator_mouth_cutter(Polygon(ordered), args[5])
+            assert_same_shape(result, expected)
+            assert points(result) == points(expected)
+    assert_same_shape(cad._clean_stator_mouth_cutter(expected, args[5]), expected)
+    assert points(cad._clean_stator_mouth_cutter(expected, args[5])) == points(expected)
+
+
+def test_long_close_chain_retains_source_instead_of_exceeding_weld_budget():
+    # Existing consecutive-edge grouping permits transitive chains wider than
+    # eps. The new source-stage intervention may not silently use that width.
+    source = Polygon([(0., 0.), (.018, 0.), (.036, 0.), (.054, 0.), (1., 0.), (1., 1.), (0., 1.)])
+    merges = {}
+    cad._sanitize_geom(source, 80., "chain", merges=merges)
+    assert max(np.linalg.norm(np.subtract(a, b)) for a, b in cad._resolve_node_map(merges).items()) > .02
+    assert cad._clean_stator_mouth_cutter(source, 80.) is source
+
+
+@pytest.mark.parametrize("replacement", [
+    Polygon([(0., 0.), (1., 0.), (1., 1.), (0., 1.)], [[(.49, .49), (.51, .49), (.51, .51), (.49, .51)]]),
+    translate(Polygon([(0., 0.), (1., 0.), (1., 1.), (0., 1.)]), xoff=.03),
+])
+def test_unmapped_topology_or_boundary_changes_are_rejected(monkeypatch, replacement):
+    source = Polygon([(0., 0.), (1., 0.), (1., 1.), (0., 1.)])
+    monkeypatch.setattr(cad, "_sanitize_geom", lambda *a, **kw: replacement)
+    assert cad._clean_stator_mouth_cutter(source, 100.) is source
+
+
+@pytest.mark.parametrize("name,geo", _cases(), ids=[c[0] for c in _cases()])
+def test_historical_stators_keep_shared_boundary_and_domain_topology(monkeypatch, name, geo):
+    # Includes explicit30/40/100/150/200mm historical geometry, plus frozen
+    # default. Compare to the canonical-mouth-only stage, never live config.
+    candidate, diameter = _build(geo)
+    with monkeypatch.context() as local:
+        local.setattr(cad, "_clean_stator_mouth_cutter", lambda source, scale: source)
+        baseline, _ = _build(geo)
+    for key in ("stator", "out_band"):
+        actual, old = candidate[key], baseline[key]
+        assert actual.is_valid and not actual.is_empty
+        assert topology(actual) == topology(old), (name, key)
+    assert not points(candidate["stator"])-points(candidate["out_band"])
+    assert candidate["stator"].intersection(candidate["out_band"]).area < 1e-9
+    if name == "preset motor_100mm":
+        stator = candidate["stator"]
+        assert_same_shape(stator, rotate(stator, 90., origin=(0., 0.)))
+        repeated = cad._sanitize_geom(stator, diameter, "stator-repeat")
+        assert_same_shape(stator, repeated)
+        assert points(stator) == points(repeated)
