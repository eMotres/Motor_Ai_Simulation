+"""The exported sampled mouth shape moves with its intended tooth pair."""
+import json
+from pathlib import Path
+
+import numpy as np
+import pytest
+from shapely.affinity import rotate, scale
+from shapely.geometry import Polygon
+
+from motor_ai_sim import cadquery_geometry as cad
+
+
+def arguments(radius=1.8116415052257349, pairs=12):
+    cut_x, outer = 9.45, 50.
+    y = (37.7+4.+radius)*np.cos(np.pi/pairs)
+    return ((cut_x, 2*outer), (cut_x, y), (cut_x+radius, y),
+            (2*outer*np.tan(np.pi/pairs), 2*outer), radius, 100., pairs)
+
+
+def assert_same_shape(first, second):
+    assert first.geom_type == second.geom_type
+    assert first.is_valid and second.is_valid
+    assert first.symmetric_difference(second).area < 2e-10
+    assert first.boundary.hausdorff_distance(second.boundary) < 2e-11
+
+
+def test_odd_27_segment_mouth_has_exact_pair_mirror_and_rotational_copies(monkeypatch):
+    args = arguments()
+    assert cad._arc_n_segments(args[4], 2*np.pi, args[5]) == 27
+    original_arc = cad._arc_points
+    calls = []
+    def observed_arc(*positional, **keywords):
+        calls.append((positional, keywords))
+        return original_arc(*positional, **keywords)
+    monkeypatch.setattr(cad, "_arc_points", observed_arc)
+    pairs = cad._stator_mouth_cutters(*args)
+    assert len(calls) == 1  # one actual sampled local circle, not resampled copies
+    assert calls[0][0] == (args[2][0], args[2][1], args[4], 0., 2*np.pi, args[5])
+    right, left = pairs[0]
+    old_right = cad._safe_union(Polygon(args[:4]), Polygon(original_arc(
+        args[2][0], args[2][1], args[4], 0., 2*np.pi, args[5])[:-1]))
+    # The intentional local weld preserves the original analytic tangent p2.
+    # A 27-gon has no sample at pi and creates a 12.25um spurious stub there.
+    expected = cad._sanitize_geom(old_right, args[5], "expected-local-mouth")
+    assert_same_shape(right, expected)
+    assert args[1] in list(right.exterior.coords)
+    assert len(right.exterior.coords) == len(old_right.exterior.coords)-1
+    assert old_right.boundary.hausdorff_distance(right.boundary) < args[5]/cad._WELD_DIV
+    assert right.area > old_right.area
+    assert_same_shape(left, scale(right, xfact=-1, yfact=1, origin=(0, 0)))
+    for i, (r, l) in enumerate(pairs):
+        assert_same_shape(r, rotate(right, i*30., origin=(0, 0)))
+        assert_same_shape(l, rotate(left, i*30., origin=(0, 0)))
+
+
+@pytest.mark.parametrize("radius", [0., -.7, .03, .7, 1.8116415052257349, 4.])
+@pytest.mark.parametrize("pairs", [6, 12])
+def test_radius_edge_cases_keep_valid_nonempty_cutter_for_geometry_validation(radius, pairs):
+    # Negative/zero mouth radii can describe infeasible machines; the CAD helper
+    # must let the existing geometry validator diagnose them, not crash first.
+    args = arguments(radius, pairs)
+    shapes = cad._stator_mouth_cutters(*args)
+    assert len(shapes) == pairs
+    old_right = cad._safe_union(Polygon(args[:4]), Polygon(cad._arc_points(
+        args[2][0], args[2][1], radius, 0., 2*np.pi, args[5])[:-1]))
+    if not old_right.is_valid:
+        old_right = old_right.buffer(0)
+    assert old_right.boundary.hausdorff_distance(shapes[0][0].boundary) <= args[5]/cad._WELD_DIV
+    assert shapes[0][0].geom_type == old_right.geom_type
+    def topology(geom):
+        parts = list(geom.geoms) if hasattr(geom, "geoms") else [geom]
+        return sorted(len(part.interiors) for part in parts)
+    assert topology(shapes[0][0]) == topology(old_right)
+    for right, left in shapes:
+        assert right.is_valid and left.is_valid
+        assert right.area > 0. and left.area == pytest.approx(right.area, abs=2e-10)
+        assert right.geom_type == left.geom_type
+
+
+class ExportCaptured(BaseException):
+    pass
+
+
+@pytest.mark.parametrize("entry", ["get_2d_polygons", "get_2d_mesh_data"])
+def test_both_actual_export_routes_use_the_canonical_pair_builder(monkeypatch, entry):
+    presets = json.loads((Path(__file__).resolve().parents[1]/"config/motor_presets.json").read_text(encoding="utf-8-sig"))
+    motor = cad.CadQueryMotor()
+    motor.set_parameters(dict(presets["motor_100mm"]["geometry"], wire_parallel=1, wire_split=1))
+    original = cad._stator_mouth_cutters
+    calls = []
+    def intercepted(*args):
+        pairs = original(*args)
+        calls.append(args)
+        assert args[-1] == 12
+        assert cad._arc_n_segments(args[4], 2*np.pi, args[5]) == 27
+        assert_same_shape(pairs[3][0], rotate(pairs[0][0], 90., origin=(0, 0)))
+        assert_same_shape(pairs[0][1], scale(pairs[0][0], xfact=-1, yfact=1, origin=(0, 0)))
+        raise ExportCaptured
+    monkeypatch.setattr(cad, "_stator_mouth_cutters", intercepted)
+    with pytest.raises(ExportCaptured):
+        getattr(motor, entry)()
+    assert len(calls) == 1
