# Production env — copy to web/.env.production and fill in real values.
#
# These VITE_* values are PUBLIC: Vite bakes them into the client bundle at build
# time, and the Firebase web config is meant to be client-visible (access is
# guarded by Firebase Security Rules, not by key secrecy). Even so, web/.env.production
# is gitignored to avoid secret-scanner noise — and you should still RESTRICT the
# Google API key in Google Cloud Console (HTTP-referrer + API restrictions).
VITE_API_URL=https://YOUR-BACKEND.a.run.app
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx
