# motor_ai_sim FEM API — self-hosted deploy image.
# Build from the REPO ROOT:  docker build -f deploy/Dockerfile.api .
# Only the working backend ships: src/ + config seed. No Firebase, no
# torch/Modulus, no notebooks/scripts/experiments.
FROM python:3.11-slim

# gmsh + OCP (cadquery) native runtime libs; libgomp for MKL/OpenMP.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libglu1-mesa libgl1 libxrender1 libxcursor1 libxft2 libxinerama1 \
        libgomp1 curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ src/
# Seed config (catalog dies, materials, motor_config). In production mount a
# VOLUME over /app/config so users.json, .auth_secret and catalog edits persist
# across image updates (see docker-compose.yml).
COPY config/ config/

ENV PYTHONPATH=/app/src \
    PYTHONUNBUFFERED=1
# Production posture. GOOGLE_CLIENT_ID / ADMIN_EMAILS / AUTH_SECRET /
# ALLOWED_ORIGINS come from the environment (see ../.env.example).
ENV AUTH_ENFORCE=1

EXPOSE 8001
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s \
    CMD curl -sf http://localhost:8001/api/health || exit 1

CMD ["python", "-m", "uvicorn", "motor_ai_sim.api:app", \
     "--host", "0.0.0.0", "--port", "8001"]
