# restic -> Hetzner Storage Box (SFTP).  TEMPLATE.
#
#   sudo install -m 600 deploy/backup/restic.env.example /etc/motres/restic.env
#   sudo editor /etc/motres/restic.env
#
# root:root 0600.  RESTIC_PASSWORD is the repository encryption key: lose it and
# the backups are unreadable, exactly like .auth_secret.  Keep a copy somewhere
# that is NOT this server (a password manager) — a key stored only on the
# machine it protects protects nothing.
#
# WHY SFTP AND NOT rclone/S3
#   A Storage Box speaks SSH natively, restic's sftp backend needs no daemon on
#   the far side, and key auth means the server can write backups without a
#   password in a file.  BX11 (1 TB) is ample: the whole config/ tree is 257 MB
#   and dies/ is 26 MB, so a year of hourlies with restic's deduplication is
#   single-digit GB.
#
# ONE-TIME SETUP on the Storage Box:
#   ssh-keygen -t ed25519 -f /root/.ssh/motres_storagebox -N ''
#   # Hetzner: enable SSH on the box, then install the key:
#   cat /root/.ssh/motres_storagebox.pub | ssh -p23 uXXXXXX@uXXXXXX.your-storagebox.de \
#       install-ssh-key
#   # /root/.ssh/config:
#   #   Host motres-box
#   #     HostName uXXXXXX.your-storagebox.de
#   #     User uXXXXXX
#   #     Port 23
#   #     IdentityFile /root/.ssh/motres_storagebox
#   #     ServerAliveInterval 30
#   sudo -E restic init

# The repository.  `motres-box` is the ssh_config Host alias above, so no
# credentials appear here.
RESTIC_REPOSITORY=sftp:motres-box:/home/restic/motres-eu

# The encryption key.  openssl rand -base64 48
RESTIC_PASSWORD=

# Storage Box links are ~1 Gbit but shared; capping keeps the hourly from
# competing with a solve for the NIC.  KiB/s, 0 = unlimited.
RESTIC_LIMIT_UPLOAD=20480

# restic keeps a local cache of the repository index — without it every run
# re-downloads it.  Must be writable by root and excluded from the backup.
RESTIC_CACHE_DIR=/var/cache/restic

# Fewer, larger pack files over a high-latency SFTP link.
RESTIC_PACK_SIZE=64
