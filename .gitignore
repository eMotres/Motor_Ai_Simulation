# Nightly tickets agent — plain-text reports written to the local machine
# (so they're readable without GitHub). Not source; never committed.
nightly-reports/

# Saved optimization scan results (runtime, not source)
optimization_saves/

# Modulus PINN transient progress files
pinn_progress.json
pinn_result.json
pinn_run.log
simulation_output/
fem_profile.log
pinn_bgrid.npz
pinn_net.pt

# user-generated saved-simulation snapshots (Compare tab)
config/saved_simulations.json

# runtime: persisted last transient (repopulates cache on restart)
config/.last_transient.json
pq.out
smoke.out
sweep.out
quick.out
config/.daxis_cache.json

# runtime: solved 3D static fields for the "3D" tab, one .npz + .json per
# (machine fingerprint, fidelity, solve kind).  Megabytes each, and every one
# of them is reproducible from `POST /api/static3d/solve`.
config/.static3d_cache/
config/.mesh_cache/

# auth secrets (self-hosted user store + JWT signing key) and the live session
# registry — every record names a browser and an ip; it is runtime state, not
# configuration, and it must never reach a commit.
config/users.json
config/.auth_secret
config/.sessions.json

# cross-run eddy warm cache (solver speedup, regenerated constantly)
config/.warm_cache.npz

# runtime: the job queue's own records — what this workspace had running and
# queued, so a restart can say so instead of showing an empty panel (migration
# Stage 4, motor_ai_sim/jobs.py).  Sixty rows of a dozen scalars, rewritten on
# every state change; state, not configuration.
config/.jobs.json

# runtime: the results ledger — one gzipped file per finished run, keyed by the
# exact solve parameters, so coming back to an operating point loads it instead
# of re-solving (2026-09-05).  Reproducible work, not configuration.
config/.run_ledger/

# runtime environment for scripts/start_api.cmd (and the server's
# /etc/motres/api.env twin): the OAuth client id and AUTH_SECRET live here, not
# in a committed .cmd.  Template: scripts/api.env.example  (migration Stage 6)
scripts/api.env
deploy/.env

# Vendor SPICE libraries (Infineon Model Terms of Use §3: confidential; no
# redistribution grant on the others).  Only the manifests are committed;
# each names the URL and sha256 of the exact file (2026-09-23).
config/devices/spice/_vendor/
# harness scratch output (netlists, wrdata, logs)
config/devices/spice/_runs/
