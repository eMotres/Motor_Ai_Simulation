# Copy to web/.env and fill in. The VITE_FIREBASE_* values are the PUBLIC Firebase
# web config (safe to expose) from Firebase console -> Project settings -> Your apps
# -> Web app -> Config. Auth stays OFF until apiKey + appId are set.
VITE_API_URL=http://localhost:8001

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=aerostator-core-simulation.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=aerostator-core-simulation
VITE_FIREBASE_STORAGE_BUCKET=aerostator-core-simulation.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=262488433808
VITE_FIREBASE_APP_ID=
