# restic -> Backblaze B2 (US region).  TEMPLATE for the US server only.  Owner decision 2026-11-10: B2, US region.
#
#   sudo install -m 600 -o root -g root deploy/backup/backup-us.env.example /etc/motres/backup-us.env
#   sudo editor /etc/motres/backup-us.env
#   sudo systemctl edit --full motres-backup-us.service   # nothing to change; it reads this file
#   set -a; . /etc/motres/backup-us.env; set +a; sudo -E restic init         # once, with the env loaded
#
# root:root 0600.  Credentials live ONLY in this file: not in git, not in a unit file, not on a command line, not in a log
# (restic prints neither the key nor the password).  The EU server has its own repository on the Hetzner Storage Box and
# never sees this file; US backups never go to the EU box.
#
# THE OWNER FILLS (4 values):
#   B2_ACCOUNT_ID    the application key ID of a B2 application key limited to ONE bucket (read + write + list + delete
#                    files; not the master key)
#   B2_ACCOUNT_KEY   that application key
#   RESTIC_REPOSITORY  b2:<bucket>:<path>  - the bucket name and a folder inside it, e.g. b2:motres-us-backup:restic
#   RESTIC_PASSWORD  the repository encryption key (openssl rand -base64 48).  Lose it and the backups are unreadable;
#                    keep a copy in a password manager, not only here.

B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=
RESTIC_REPOSITORY=b2:BUCKET:restic
RESTIC_PASSWORD=

# Uplink cap in KiB/s so the hourly run does not compete with a solve for the NIC (0 = unlimited).
RESTIC_LIMIT_UPLOAD=20480
# restic's local index cache: writable by root, never backed up.
RESTIC_CACHE_DIR=/var/cache/restic
# Fewer, larger packs: fewer B2 transactions.
RESTIC_PACK_SIZE=64
