# restic backup of the US server tree -> Backblaze B2 (US).  The US twin of motres-backup.service
# (docs/regions/DESIGN.md section 12).  Own repository, own key, own include list; never the EU Storage Box.
#
# WHAT IS NOT BACKED UP
#   * the mirrored library: restorable from EU.  ExecStartPre regenerates restic-exclude-mirrored.txt from the mirror's
#     state file (the list of files the mirror installed), so closed motors of US accounts and every region-owned store in
#     /srv/motres/shared ARE backed up.
#   * run/foreign_jobs/ (the other region's jobs): never, in either region.
#
# Pruning (forget --prune) and the structure check are in motres-backup-us-prune.service, DAILY: a prune takes the repository's
# exclusive lock and rewrites packs (B2 transactions), which an hourly job should not do.
#
# Setup: docs/regions/INSTALL_US_MIRROR.md section 4.  Credentials come only from /etc/motres/backup-us.env (0600, root).

[Unit]
Description=motor_ai_sim restic backup (US server) to Backblaze B2
Documentation=file:///opt/motres/app/docs/regions/INSTALL_US_MIRROR.md
After=network-online.target docker.service
Wants=network-online.target
ConditionPathExists=/etc/motres/backup-us.env

[Service]
Type=oneshot
EnvironmentFile=/etc/motres/backup-us.env
Nice=15
IOSchedulingClass=idle

# The exclude list of the mirrored files.  The mirror directory belongs to the application user (10001), never to root: the
# worker container writes the list, the mirror job its state.  If regenerating fails (worker down) the previous list is
# used - a stale list can only back up a little more, never less - and an empty file is made so that restic can start.
ExecStartPre=/usr/bin/install -d -o 10001 -g 10001 -m 0750 /srv/motres/identity/mirror
ExecStartPre=-/bin/bash /opt/motres/app/deploy/bluegreen.sh exec worker python -m motor_ai_sim.regions.catalog_mirror backup-exclude
ExecStartPre=/bin/bash -c '[ -e /srv/motres/identity/mirror/restic-exclude-mirrored.txt ] || install -o 10001 -g 10001 -m 0644 /dev/null /srv/motres/identity/mirror/restic-exclude-mirrored.txt'

# --limit-upload is a restic OPTION (KiB/s, 0 = unlimited); restic does not read it from the environment.  The value comes
# from LIMIT_UPLOAD_KIB in the env file through systemd's own ${...} expansion.
ExecStart=/usr/bin/restic backup \
    --limit-upload ${LIMIT_UPLOAD_KIB} \
    --files-from /etc/motres/restic-include-us.txt \
    --exclude-file /etc/motres/restic-exclude.txt \
    --exclude-file /etc/motres/restic-exclude-us.txt \
    --exclude-file /srv/motres/identity/mirror/restic-exclude-mirrored.txt \
    --tag hourly \
    --host motres-us

TimeoutStartSec=3600
